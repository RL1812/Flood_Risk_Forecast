# Data.gov.sg API Key (Optional for higher rate limits, works without key on public tier)
DATA_GOV_SG_API_KEY=example

# Google Gemini API Key (Optional: for news event extraction pipeline)
GEMINI_FREE_API_KEY=your_gemini_api_key_here

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=production
PORT=5000

# CARTO API key 
CARTO_API_KEY=your_carto_api_key_here
